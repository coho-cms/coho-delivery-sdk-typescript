{
  "name": "create-coho",
  "version": "2026.2.0-alpha.1",
  "description": "Creates a content library for Coho CMS: a TypeScript package, generated from your content types, that your sites and services install.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "create-coho": "dist/index.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "bundle": "node scripts/bundle.ts",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coho-cms/coho-delivery-sdk-typescript.git",
    "directory": "packages/create-coho"
  },
  "homepage": "https://github.com/coho-cms/coho-delivery-sdk-typescript#readme",
  "keywords": [
    "coho",
    "cms",
    "create",
    "starter",
    "typescript"
  ]
}
