{
  "name": "@coho-cms/codegen",
  "version": "0.1.0-alpha.6",
  "description": "Generates a typed content library from your Coho CMS content types.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "coho-codegen": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coho-cms/coho-delivery-sdk-typescript.git",
    "directory": "packages/codegen"
  },
  "homepage": "https://github.com/coho-cms/coho-delivery-sdk-typescript#readme",
  "keywords": [
    "coho",
    "cms",
    "headless",
    "codegen",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
