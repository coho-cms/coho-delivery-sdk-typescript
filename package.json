{
  "name": "coho-delivery-sdk-typescript",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build -w @coho-cms/delivery && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run build -w @coho-cms/delivery && npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/eslint-parser": "8.0.7",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.0",
    "eslint": "10.13.0",
    "typescript": "7.0.2"
  }
}
